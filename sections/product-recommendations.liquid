{%- if recommendations.performed and recommendations.products_count > 0 -%}
  <div class="band band--sheet">
    <div class="wrap section-pad">
      <div class="speclabel">
        <span class="speclabel__no">§ —</span>
        <span class="speclabel__name">{{ section.settings.heading }}</span>
        <span class="speclabel__rule"></span>
        <span class="speclabel__meta">compare at true size</span>
      </div>
      <div class="cards">
        {%- for product in recommendations.products -%}
          {% render 'product-card', product: product, pod_mm: 7 %}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- else -%}
  <div data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.count }}"></div>
{%- endif -%}
{% schema %}
{
  "name": "Recommendations",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The same lot, one sieve down" },
    { "type": "range", "id": "count", "label": "How many", "min": 2, "max": 8, "step": 1, "default": 3 }
  ]
}
{% endschema %}
