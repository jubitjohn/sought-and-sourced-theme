<div class="wrap wrap--narrow" style="padding:44px 28px 60px;max-width:520px">
  <h1 style="margin-bottom:24px">{{ 'customer.activate_account.title' | t }}</h1>
  {%- form 'activate_customer_password' -%}
    {%- if form.errors -%}<div class="form-error">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="form-row">
      <label for="ActPassword">{{ 'customer.login.password' | t }}</label>
      <input class="input" type="password" id="ActPassword" name="customer[password]" autocomplete="new-password">
    </div>
    <div class="form-row">
      <label for="ActConfirm">Confirm password</label>
      <input class="input" type="password" id="ActConfirm" name="customer[password_confirmation]" autocomplete="new-password">
    </div>
    <button class="btn btn--primary btn--full" type="submit">{{ 'customer.activate_account.submit' | t }}</button>
    <button class="linkish" style="margin-top:14px" type="submit" name="decline">{{ 'customer.activate_account.decline' | t }}</button>
  {%- endform -%}
</div>
{% schema %}
{ "name": "Activate account", "settings": [] }
{% endschema %}
