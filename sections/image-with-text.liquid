{%- comment -%}
  The origin story. Photography on one side, the claim and the record on the
  other — the record panel ruled like the nutrition table on the back of the
  label, so the facts read as printed facts rather than marketing.
{%- endcomment -%}
{%- assign s = section.settings -%}
<div class="wrap section-pad">
  {%- if s.label != blank -%}
    <div class="speclabel">
      <span class="speclabel__no">{{ s.number }}</span>
      <span class="speclabel__name">{{ s.label }}</span>
      <span class="speclabel__rule"></span>
      <span class="speclabel__meta">{{ s.meta }}</span>
    </div>
  {%- endif -%}
  <div class="story{% if s.flip %} story--flip{% endif %}">
    <div class="story__art">
      {%- if s.image -%}
        {%- assign alt_text = s.image_alt | default: s.heading | strip_html | escape -%}
        {{ s.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '480,760,1100,1600', sizes: '(max-width:860px) 92vw, 46vw', alt: alt_text }}
      {%- else -%}
        <div class="story__empty">{% render 'botanical', variant: 'field' %}</div>
      {%- endif -%}
    </div>
    <div class="story__body">
      {%- if s.kicker != blank -%}<div class="hero-banner__eyebrow">{{ s.kicker }}</div>{%- endif -%}
      <h2 class="story__h">{{ s.heading }}</h2>
      <div class="rte story__text">{{ s.text }}</div>

      {%- if section.blocks.size > 0 -%}
        <dl class="readout story__readout" {% if s.readout_title != blank %}data-title="{{ s.readout_title | escape }}"{% endif %}>
          {%- for block in section.blocks -%}
            <div class="readout__row" {{ block.shopify_attributes }}>
              <dt>{{ block.settings.key }}</dt>
              <dd>{{ block.settings.value }}</dd>
            </div>
          {%- endfor -%}
          {%- if s.footnote != blank -%}<p class="workings">{{ s.footnote }}</p>{%- endif -%}
        </dl>
      {%- endif -%}

      {%- if s.link_label != blank -%}
        <p class="story__cta"><a class="btn btn--ghost btn--small" href="{{ s.link | default: routes.all_products_collection_url }}">{{ s.link_label }}</a></p>
      {%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Story",
  "settings": [
    { "type": "text", "id": "number", "label": "Section mark", "default": "§ —" },
    { "type": "text", "id": "label", "label": "Label", "default": "The region", "info": "Leave empty to drop the section header." },
    { "type": "text", "id": "meta", "label": "Right-hand note" },
    { "type": "header", "content": "Artwork" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image description" },
    { "type": "checkbox", "id": "flip", "label": "Put the image on the right", "default": false },
    { "type": "header", "content": "The copy" },
    { "type": "text", "id": "kicker", "label": "Eyebrow", "default": "Where it grows" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Cardamom Hills" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Cardamom grows here between roughly 900 and 1,400 metres, under shade, on the western slopes of the Ghats. Harvest runs October to February and the pods are picked green, several passes to a plant, because they do not ripen together.</p>" },
    { "type": "text", "id": "link_label", "label": "Button label", "default": "Shop the harvest" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "header", "content": "The record" },
    { "type": "paragraph", "content": "Ruled like the nutrition panel on the back of the label. Add a row block for each line; leave the blocks off to drop the panel." },
    { "type": "text", "id": "readout_title", "label": "Record header", "default": "The Record" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "Figures describe the growing region, not a single farm." }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Record row",
      "settings": [
        { "type": "text", "id": "key", "label": "Label", "default": "Region" },
        { "type": "text", "id": "value", "label": "Value", "default": "Cardamom Hills, Idukki" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Story",
      "blocks": [
        { "type": "row", "settings": { "key": "Species", "value": "Elettaria cardamomum" } },
        { "type": "row", "settings": { "key": "Region", "value": "Cardamom Hills, Idukki" } },
        { "type": "row", "settings": { "key": "Elevation", "value": "900 – 1,400 m" } },
        { "type": "row", "settings": { "key": "Harvest", "value": "Oct – Feb" } }
      ]
    }
  ]
}
{% endschema %}
