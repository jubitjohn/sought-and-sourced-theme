<div class="wrap">
  <div class="account-grid">
    <div>
      <h1 style="margin-bottom:22px">{{ 'customer.account.orders' | t }}</h1>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <div class="table-scroll">
            <table class="table">
              <thead><tr>
                <th>{{ 'customer.orders.order_number' | t }}</th>
                <th>{{ 'customer.orders.date' | t }}</th>
                <th>{{ 'customer.orders.payment' | t }}</th>
                <th>{{ 'customer.orders.fulfillment' | t }}</th>
                <th>{{ 'customer.orders.total' | t }}</th>
              </tr></thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                    <td>{{ order.created_at | date: '%-d %b %Y' }}</td>
                    <td>{{ order.financial_status_label }}</td>
                    <td>{{ order.fulfillment_status_label }}</td>
                    <td>{{ order.total_price | money }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        {%- else -%}
          <p class="body-text">{{ 'customer.orders.none' | t }}</p>
        {%- endif -%}
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    </div>
    <aside>
      <div class="eyebrow" style="margin-bottom:10px">{{ 'customer.addresses.default' | t }}</div>
      <div class="body-text" style="font-size:.9rem">{{ customer.default_address | format_address }}</div>
      <p style="margin-top:18px"><a class="linkish" href="{{ routes.account_addresses_url }}">{{ 'customer.account.addresses' | t }}</a></p>
      <p><a class="linkish" href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a></p>
    </aside>
  </div>
</div>
{% schema %}
{ "name": "Account", "settings": [] }
{% endschema %}
