<div class="wrap section-pad">
  <div class="speclabel">
    <span class="speclabel__no">{{ section.settings.number }}</span>
    <span class="speclabel__name">{{ section.settings.label }}</span>
    <span class="speclabel__rule"></span>
    <span class="speclabel__meta">{{ section.settings.meta }}</span>
  </div>
  {%- liquid
    comment
      With no collection picked (or an empty one), show the whole catalogue
      rather than placeholders, so products are on the home page from day one.
    endcomment
    assign coll = section.settings.collection
    if coll == blank or coll.products.size == 0
      assign coll = collections.all
    endif
  -%}
  <div class="cards">
    {%- if coll.products.size > 0 -%}
      {%- for product in coll.products limit: section.settings.count -%}
        {%- assign fallback_mm = forloop.index | plus: 5 -%}
        {% render 'product-card', product: product, pod_mm: fallback_mm, trust: section.settings.card_trust %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..3) -%}
        {%- assign fallback_mm = i | plus: 5 -%}
        <article class="card">
          <div class="card__art gridpaper">{% render 'pod', mm: fallback_mm %}{% render 'pod', mm: fallback_mm %}</div>
          <div class="card__body">
            <div class="card__grade">{{ fallback_mm }} mm</div>
            <h3 class="card__name">{{ 'onboarding.product_title' | t }}</h3>
            <p class="card__note">Add products in Shopify admin and they will show here.</p>
            <div class="card__foot"><span>&mdash;</span></div>
          </div>
        </article>
      {%- endfor -%}
    {%- endif -%}
  </div>
  {%- if section.blocks.size > 0 -%}
    <ul class="trustbar">
      {%- for block in section.blocks -%}
        <li class="trustbar__item" {{ block.shopify_attributes }}>
          <span class="trustbar__ring">{% render 'icon', icon: block.settings.icon %}</span>
          <span class="trustbar__cap">{{ block.settings.caption }}</span>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
  {%- if section.settings.link_label != blank -%}
    {%- assign all_url = coll.url | default: routes.all_products_collection_url -%}
    <p class="cards__cta"><a class="btn btn--ghost" href="{{ all_url }}">{{ section.settings.link_label }}</a></p>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "number", "label": "Section mark", "default": "§ 04" },
    { "type": "text", "id": "label", "label": "Label", "default": "Current lots" },
    { "type": "text", "id": "meta", "label": "Right-hand note", "default": "packed to order" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show every product in the store. Set the collection's sort to Best selling to lead with what sells." },
    { "type": "range", "id": "count", "label": "Products shown", "min": 2, "max": 12, "step": 1, "default": 3 },
    { "type": "text", "id": "link_label", "label": "Button under the grid", "default": "See every lot", "info": "Goes to the chosen collection, or to all products when none is set. Leave empty to drop the button." },
    { "type": "header", "content": "Badges and trust" },
    { "type": "paragraph", "content": "Tag a product Bestseller or Organic in admin to badge its card. Star ratings appear on their own once a reviews app fills Shopify's product rating fields." },
    { "type": "text", "id": "card_trust", "label": "Ticked claims on every card", "default": "Single origin, Graded by sieve, Sealed light-proof", "info": "Separate with commas. These print on every card in this grid, so keep to what is true of all of them. Leave empty to drop the line." }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust mark",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Glyph",
          "options": [
            { "value": "lock", "label": "Padlock — secure checkout" },
            { "value": "truck", "label": "Van — delivery" },
            { "value": "return", "label": "Arrow — returns" },
            { "value": "calendar", "label": "Calendar — dated" },
            { "value": "airtight", "label": "Tin — sealed, air-tight" },
            { "value": "leaf", "label": "Leaf — natural, unblended" },
            { "value": "caliper", "label": "Caliper — a size or grade" },
            { "value": "origin", "label": "Pin — an origin" },
            { "value": "star", "label": "Star — a quality claim" }
          ],
          "default": "lock"
        },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Secure checkout", "info": "Two to four words, set in tracked caps. Only promise what your shipping and refund policies actually say." }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Featured collection",
      "blocks": [
        { "type": "trust", "settings": { "icon": "lock", "caption": "Secure checkout" } },
        { "type": "trust", "settings": { "icon": "airtight", "caption": "Packed to order" } },
        { "type": "trust", "settings": { "icon": "calendar", "caption": "Dated on every tin" } }
      ]
    }
  ]
}
{% endschema %}
