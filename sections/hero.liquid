{%- comment -%}
  Hero banner — Sought & Sourced.

  The photograph runs edge to edge inside a thin double brass frame. The copy
  sits on a cream label plaque (arched, double-ruled in brass) that by default
  is set LOW: it laps over the bottom edge of the photograph onto a bottle-green
  band, so the picture itself stays clear. Three placements:

    • overlap — plaque laps the bottom edge of the image (default)
    • below   — plaque sits fully under the image; nothing covers the picture
    • over    — plaque sits inside the image, anchored to the bottom

  Everything is styled here, scoped to this section, so it does not depend on
  the theme stylesheet. Saved settings from the earlier version keep working.
{%- endcomment -%}
{%- liquid
  assign h = section.settings
  assign sid = '#shopify-section-' | append: section.id
  assign style = h.overlay_style | default: 'plaque'
  assign pos = h.copy_position | default: 'overlap'
  assign align = h.align | default: 'left'
  assign height = h.height | default: 'tall'
  assign lap = h.lap | default: 140
  assign has_copy = false
  if h.heading != blank or h.lede != blank or h.eyebrow != blank or h.attributes != blank or h.cta_label != blank or h.cta2_label != blank
    assign has_copy = true
  endif
  if style == 'none'
    assign has_copy = false
  endif
  if has_copy == false
    assign pos = 'none'
  endif
-%}
{%- if h.load_fonts -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Josefin+Sans:wght@500;600&display=swap">
{%- endif -%}
<style>
  {{ sid }}{
    --hb-green:#1f3d2c; --hb-green-deep:#142a1e; --hb-green-soft:#2a5139;
    --hb-brass:#d4b26a; --hb-brass-deep:#a8843f; --hb-cream:#f6efe0; --hb-paper:#fbf7ee; --hb-ink:#1b2a21;
    --hb-display:'Cinzel', 'Trajan Pro', Georgia, serif;
    --hb-serif:'Cormorant Garamond', 'Cormorant', Georgia, serif;
    --hb-caps:'Josefin Sans', 'Futura', 'Helvetica Neue', Arial, sans-serif;
    --hb-lap:{{ lap }}px;
    display:block;
  }
  {{ sid }} .hb{position:relative;isolation:isolate;background:radial-gradient(120% 90% at 50% 0%, var(--hb-green-soft) 0%, var(--hb-green) 45%, var(--hb-green-deep) 100%);color:var(--hb-cream);overflow:hidden}
  {{ sid }} .hb *,{{ sid }} .hb *::before,{{ sid }} .hb *::after{box-sizing:border-box}

  /* ---------- Photograph ---------- */
  {{ sid }} .hb__media{position:relative;width:100%;height:var(--hb-h);min-height:340px;overflow:hidden;background:var(--hb-green-deep)}
  {{ sid }} .hb--h-short{--hb-h:clamp(340px,52vh,560px)}
  {{ sid }} .hb--h-tall{--hb-h:clamp(420px,74vh,820px)}
  {{ sid }} .hb--h-full{--hb-h:calc(100svh - var(--hb-header,0px))}
  {{ sid }} .hb__img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.04);animation:hb-settle 1.8s cubic-bezier(.2,.7,.2,1) forwards}
  {{ sid }} .hb__img--empty{display:flex;align-items:center;justify-content:center;background:radial-gradient(80% 80% at 50% 40%, var(--hb-green-soft), var(--hb-green-deep));color:var(--hb-brass);opacity:.9}
  {{ sid }} .hb__img--empty svg{width:min(60%,520px);height:auto;opacity:.35}
  {{ sid }} .hb__scrim{position:absolute;inset:0;background:rgba(12,24,17,var(--scrim,0));pointer-events:none}
  /* soft fade into the green band so the plaque has somewhere to land */
  {{ sid }} .hb__fade{position:absolute;left:0;right:0;bottom:0;height:38%;background:linear-gradient(to bottom, rgba(20,42,30,0) 0%, rgba(20,42,30,.55) 70%, rgba(20,42,30,.85) 100%);pointer-events:none}
  {{ sid }} .hb--pos-none .hb__fade{display:none}
  /* thin double brass frame, like the label border */
  {{ sid }} .hb__frame{position:absolute;inset:clamp(12px,2vw,26px);border:1px solid rgba(212,178,106,.75);pointer-events:none}
  {{ sid }} .hb__frame::after{content:"";position:absolute;inset:6px;border:1px solid rgba(212,178,106,.35)}
  {{ sid }} .hb__corner{position:absolute;width:18px;height:18px;color:var(--hb-brass)}
  {{ sid }} .hb__corner--tl{top:-9px;left:-9px}{{ sid }} .hb__corner--tr{top:-9px;right:-9px}
  {{ sid }} .hb__corner--bl{bottom:-9px;left:-9px}{{ sid }} .hb__corner--br{bottom:-9px;right:-9px}

  /* ---------- Copy placement ---------- */
  {{ sid }} .hb__content{position:relative;z-index:2;display:flex;padding:0 clamp(16px,5vw,72px)}
  {{ sid }} .hb--align-left .hb__content{justify-content:flex-start}
  {{ sid }} .hb--align-center .hb__content{justify-content:center}
  {{ sid }} .hb--align-right .hb__content{justify-content:flex-end}
  {{ sid }} .hb--pos-overlap .hb__content{margin-top:calc(-1 * var(--hb-lap));padding-bottom:clamp(40px,6vw,88px)}
  {{ sid }} .hb--pos-below .hb__content{padding-top:clamp(40px,5vw,72px);padding-bottom:clamp(48px,6vw,96px)}
  {{ sid }} .hb--pos-over .hb__content{position:absolute;inset:auto 0 0 0;padding-bottom:clamp(40px,6vw,88px)}
  {{ sid }} .hb--pos-below.hb--align-center .hb__content,{{ sid }} .hb--pos-overlap.hb--align-center .hb__content{text-align:center}

  /* ---------- Plaque ---------- */
  {{ sid }} .hb__box{position:relative;width:min(100%,600px);animation:hb-rise 1.1s .25s cubic-bezier(.2,.7,.2,1) both}
  {{ sid }} .hb__box--plaque{
    background:linear-gradient(180deg,var(--hb-paper) 0%,var(--hb-cream) 100%);color:var(--hb-ink);
    border-radius:300px 300px 6px 6px / 170px 170px 6px 6px;
    padding:clamp(64px,7vw,92px) clamp(28px,4.5vw,60px) clamp(32px,4vw,48px);
    text-align:center;
    box-shadow:0 0 0 1px rgba(168,132,63,.25), 0 30px 60px -20px rgba(6,14,9,.55), 0 10px 24px -12px rgba(6,14,9,.4);
  }
  {{ sid }} .hb__box--plaque::before,{{ sid }} .hb__box--plaque::after{content:"";position:absolute;pointer-events:none;border-radius:inherit}
  {{ sid }} .hb__box--plaque::before{inset:10px;border:1.5px solid var(--hb-brass)}
  {{ sid }} .hb__box--plaque::after{inset:16px;border:1px solid rgba(212,178,106,.55)}
  {{ sid }} .hb__box--plaque > *{position:relative;z-index:1}
  {{ sid }} .hb__box--bare{text-align:left;color:var(--hb-cream)}
  {{ sid }} .hb--align-center .hb__box--bare{text-align:center}
  {{ sid }} .hb--align-right .hb__box--bare{text-align:right}
  {{ sid }} .hb--pos-over .hb__box--bare{text-shadow:0 2px 18px rgba(0,0,0,.45)}

  {{ sid }} .hb__sprig{display:block;width:46px;height:46px;margin:-22px auto 14px;color:var(--hb-brass-deep)}
  {{ sid }} .hb__sprig svg{width:100%;height:100%}
  {{ sid }} .hb__eyebrow{font-family:var(--hb-caps);font-weight:600;font-size:11.5px;letter-spacing:.32em;text-transform:uppercase;color:var(--hb-brass-deep);margin:0 0 16px}
  {{ sid }} .hb__box--bare .hb__eyebrow{color:var(--hb-brass)}
  {{ sid }} .hb__h{font-family:var(--hb-display);font-weight:600;font-size:clamp(28px,3.6vw,46px);line-height:1.12;letter-spacing:.015em;margin:0;color:var(--hb-green);text-wrap:balance}
  {{ sid }} .hb__h em{font-family:var(--hb-serif);font-style:italic;font-weight:500;letter-spacing:0;color:var(--hb-brass-deep);font-size:1.12em}
  {{ sid }} .hb__box--bare .hb__h{color:var(--hb-cream);font-size:clamp(32px,4.4vw,60px)}
  {{ sid }} .hb__box--bare .hb__h em{color:var(--hb-brass)}

  {{ sid }} .hb__rule{display:flex;align-items:center;justify-content:center;gap:12px;margin:22px auto 18px;color:var(--hb-brass)}
  {{ sid }} .hb__rule i{display:block;height:1px;width:64px;background:currentColor;opacity:.8}
  {{ sid }} .hb__rule b{display:block;width:7px;height:7px;transform:rotate(45deg);border:1px solid currentColor}
  {{ sid }} .hb__box--bare .hb__rule{justify-content:flex-start}
  {{ sid }} .hb--align-center .hb__box--bare .hb__rule{justify-content:center}
  {{ sid }} .hb--align-right .hb__box--bare .hb__rule{justify-content:flex-end}

  {{ sid }} .hb__attrs{font-family:var(--hb-caps);font-weight:500;font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:var(--hb-green);margin:0 0 16px}
  {{ sid }} .hb__box--bare .hb__attrs{color:var(--hb-cream);opacity:.9}
  {{ sid }} .hb__lede{font-family:var(--hb-serif);font-style:italic;font-size:clamp(18px,1.6vw,21px);line-height:1.5;color:#3b4a40;max-width:34em;margin:0 auto}
  {{ sid }} .hb__lede p{margin:0}
  {{ sid }} .hb__box--bare .hb__lede{color:rgba(246,239,224,.9);margin:0}
  {{ sid }} .hb--align-center .hb__box--bare .hb__lede{margin:0 auto}
  {{ sid }} .hb--align-right .hb__box--bare .hb__lede{margin:0 0 0 auto}

  /* ---------- Buttons ---------- */
  {{ sid }} .hb__ctas{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-top:28px}
  {{ sid }} .hb__box--bare .hb__ctas{justify-content:flex-start}
  {{ sid }} .hb--align-center .hb__box--bare .hb__ctas{justify-content:center}
  {{ sid }} .hb--align-right .hb__box--bare .hb__ctas{justify-content:flex-end}
  {{ sid }} .hb__btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:50px;padding:0 28px;font-family:var(--hb-caps);font-weight:600;font-size:12px;letter-spacing:.22em;text-transform:uppercase;text-decoration:none;border-radius:2px;transition:background-color .25s, color .25s, border-color .25s, transform .25s}
  {{ sid }} .hb__btn--primary{background:var(--hb-green);color:var(--hb-cream);border:1px solid var(--hb-green);box-shadow:inset 0 0 0 3px var(--hb-green), inset 0 0 0 4px rgba(212,178,106,.7)}
  {{ sid }} .hb__btn--primary:hover{background:var(--hb-green-deep);box-shadow:inset 0 0 0 3px var(--hb-green-deep), inset 0 0 0 4px var(--hb-brass);transform:translateY(-1px)}
  {{ sid }} .hb__btn--primary svg{width:14px;height:14px;transition:transform .25s}
  {{ sid }} .hb__btn--primary:hover svg{transform:translateX(3px)}
  {{ sid }} .hb__btn--ghost{background:transparent;color:var(--hb-green);border:1px solid rgba(31,61,44,.45)}
  {{ sid }} .hb__btn--ghost:hover{border-color:var(--hb-brass-deep);color:var(--hb-brass-deep)}
  {{ sid }} .hb__box--bare .hb__btn--primary{background:var(--hb-brass);color:var(--hb-green-deep);border-color:var(--hb-brass);box-shadow:none}
  {{ sid }} .hb__box--bare .hb__btn--primary:hover{background:#e2c588}
  {{ sid }} .hb__box--bare .hb__btn--ghost{color:var(--hb-cream);border-color:rgba(246,239,224,.55)}
  {{ sid }} .hb__box--bare .hb__btn--ghost:hover{border-color:var(--hb-brass);color:var(--hb-brass)}
  {{ sid }} .hb__btn:focus-visible{outline:2px solid var(--hb-brass);outline-offset:3px}

  /* ---------- Motion ---------- */
  @keyframes hb-settle{to{transform:scale(1)}}
  @keyframes hb-rise{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
  @media (prefers-reduced-motion: reduce){
    {{ sid }} .hb__img,{{ sid }} .hb__box{animation:none;transform:none}
  }

  /* ---------- Phones ---------- */
  @media (max-width: 749px){
    {{ sid }} .hb--h-short{--hb-h:clamp(260px,48vh,420px)}
    {{ sid }} .hb--h-tall{--hb-h:clamp(300px,58vh,520px)}
    {{ sid }} .hb__content{padding:0 16px;justify-content:center !important}
    {{ sid }} .hb--pos-overlap .hb__content{margin-top:calc(-1 * min(var(--hb-lap), 90px));padding-bottom:40px}
    /* on a phone the plaque would hide most of the photo, so it always moves under it */
    {{ sid }} .hb--pos-over .hb__content{position:relative;margin-top:-70px;padding-bottom:40px}
    {{ sid }} .hb__box{width:100%}
    {{ sid }} .hb__box--plaque{border-radius:220px 220px 4px 4px / 110px 110px 4px 4px;padding:56px 22px 30px}
    {{ sid }} .hb__box--bare,{{ sid }} .hb__box--bare .hb__lede{text-align:center;margin-left:auto;margin-right:auto}
    {{ sid }} .hb__box--bare .hb__rule,{{ sid }} .hb__box--bare .hb__ctas{justify-content:center}
    {{ sid }} .hb__ctas{flex-direction:column;align-items:stretch}
    {{ sid }} .hb__eyebrow{font-size:10.5px;letter-spacing:.26em}
    {{ sid }} .hb__frame{inset:10px}
  }
</style>

<section class="hb hb--h-{{ height }} hb--pos-{{ pos }} hb--align-{{ align }}" data-hero-banner>
  <div class="hb__media">
    {%- if h.image -%}
      {%- assign alt_text = h.image_alt | default: shop.name | escape -%}
      {%- capture img_style -%}object-position:center {{ h.focal | default: 'center' }}{%- endcapture -%}
      {{ h.image
         | image_url: width: 2400
         | image_tag:
             widths: '640,900,1200,1600,2000,2400',
             sizes: '100vw',
             fetchpriority: 'high',
             loading: 'eager',
             class: 'hb__img',
             alt: alt_text,
             style: img_style }}
    {%- else -%}
      {%- comment -%} Composed before any photography exists. {%- endcomment -%}
      <div class="hb__img hb__img--empty">
        {% render 'botanical', variant: 'field' %}
      </div>
    {%- endif -%}

    {%- if h.scrim > 0 -%}
      <div class="hb__scrim" style="--scrim:{{ h.scrim | divided_by: 100.0 }}" aria-hidden="true"></div>
    {%- endif -%}
    <div class="hb__fade" aria-hidden="true"></div>

    {%- if h.show_frame -%}
      <div class="hb__frame" aria-hidden="true">
        {%- for c in (1..4) -%}
          {%- case c -%}{%- when 1 -%}{%- assign cn = 'tl' -%}{%- when 2 -%}{%- assign cn = 'tr' -%}{%- when 3 -%}{%- assign cn = 'bl' -%}{%- else -%}{%- assign cn = 'br' -%}{%- endcase -%}
          <svg class="hb__corner hb__corner--{{ cn }}" viewBox="0 0 18 18"><path d="M9 1 L17 9 L9 17 L1 9 Z" fill="currentColor"/></svg>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- if has_copy -%}
    <div class="hb__content">
      <div class="hb__box hb__box--{{ style }}">
        {%- if style == 'plaque' and h.show_sprig -%}
          <span class="hb__sprig" aria-hidden="true">{% render 'botanical', variant: 'sprig' %}</span>
        {%- endif -%}
        {%- if h.eyebrow != blank -%}
          <p class="hb__eyebrow">{{ h.eyebrow }}</p>
        {%- endif -%}
        {%- if h.heading != blank -%}
          <h1 class="hb__h">{{ h.heading }}</h1>
        {%- endif -%}
        {%- if h.attributes != blank or h.lede != blank -%}
          <div class="hb__rule" aria-hidden="true"><i></i><b></b><i></i></div>
        {%- endif -%}
        {%- if h.attributes != blank -%}
          <p class="hb__attrs">{{ h.attributes }}</p>
        {%- endif -%}
        {%- if h.lede != blank -%}
          <div class="hb__lede">{{ h.lede }}</div>
        {%- endif -%}
        {%- if h.cta_label != blank or h.cta2_label != blank -%}
          <div class="hb__ctas">
            {%- if h.cta_label != blank -%}
              <a class="hb__btn hb__btn--primary" href="{{ h.cta_link | default: routes.all_products_collection_url }}">
                <span>{{ h.cta_label }}</span>
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
              </a>
            {%- endif -%}
            {%- if h.cta2_label != blank -%}
              <a class="hb__btn hb__btn--ghost" href="{{ h.cta2_link | default: '#journey' }}">{{ h.cta2_label }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>

{%- comment -%}
  Full-screen height: subtract the sticky header so the banner fits the window.
{%- endcomment -%}
<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    function measure() {
      var hd = document.querySelector('.site-header');
      var hh = hd ? Math.round(hd.getBoundingClientRect().height) : 0;
      root.style.setProperty('--hb-header', hh + 'px');
    }
    measure();
    window.addEventListener('resize', measure, { passive: true });
    window.addEventListener('load', measure);
  })();
</script>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "header", "content": "Artwork" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Landscape, at least 2000px wide. It is cropped to fill, so keep the subject off the very edges." },
    { "type": "text", "id": "image_alt", "label": "Image description", "info": "For screen readers and when the image fails to load. Defaults to the shop name." },
    {
      "type": "select", "id": "focal", "label": "Keep this part of the image in frame",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select", "id": "height", "label": "Height",
      "options": [
        { "value": "short", "label": "Short" },
        { "value": "tall", "label": "Tall" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "tall"
    },
    { "type": "range", "id": "scrim", "label": "Darken the image", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 15, "info": "Only needed to settle a busy photograph. The plaque carries the contrast on its own." },
    { "type": "checkbox", "id": "show_frame", "label": "Brass frame around the image", "default": true },
    { "type": "header", "content": "The copy" },
    {
      "type": "select", "id": "overlay_style", "label": "How the copy sits",
      "options": [
        { "value": "plaque", "label": "On a label plaque" },
        { "value": "bare", "label": "Without a plaque" },
        { "value": "none", "label": "No copy — artwork only" }
      ],
      "default": "plaque",
      "info": "Choose 'artwork only' when the image already carries the wordmark and product name."
    },
    {
      "type": "select", "id": "copy_position", "label": "Where the copy sits",
      "options": [
        { "value": "overlap", "label": "Low, lapping the bottom of the image" },
        { "value": "below", "label": "Under the image" },
        { "value": "over", "label": "On top of the image" }
      ],
      "default": "overlap",
      "info": "'Low' and 'Under' keep the photograph clear. On phones the copy always sits under the image."
    },
    { "type": "range", "id": "lap", "label": "How far the plaque laps onto the image", "min": 40, "max": 300, "step": 10, "unit": "px", "default": 140, "info": "Only for 'Low'. Smaller pushes the copy further down, off the picture." },
    {
      "type": "select", "id": "align", "label": "Left, centre or right",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "checkbox", "id": "show_sprig", "label": "Leaf mark above the copy", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Single origin · Idukki, Kerala" },
    { "type": "inline_richtext", "id": "heading", "label": "Headline", "default": "From the Cardamom Hills, <em>by hand</em>, to yours." },
    { "type": "text", "id": "attributes", "label": "Attribute line", "default": "Single-Origin · Hand Selected · Estate Fresh" },
    { "type": "richtext", "id": "lede", "label": "Standfirst", "default": "<p>Bought by aroma, graded by sieve, and sold whole — because the pod is the only packaging that actually keeps.</p>" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "cta_label", "label": "Primary button", "default": "Shop the harvest" },
    { "type": "url", "id": "cta_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button", "default": "Follow the journey" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link", "info": "Leave empty to scroll down to the Journey section on the same page." },
    { "type": "header", "content": "Type" },
    { "type": "checkbox", "id": "load_fonts", "label": "Use the label typefaces", "default": true, "info": "Cinzel, Cormorant and Josefin Sans, matching the label. Untick if your theme already loads these fonts." }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}

