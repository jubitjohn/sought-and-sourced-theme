<div class="wrap wrap--narrow" style="padding:44px 28px 60px;max-width:520px">
  <h1 style="margin-bottom:24px">{{ 'customer.reset_password.title' | t }}</h1>
  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}<div class="form-error">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="form-row">
      <label for="ResetPassword">{{ 'customer.login.password' | t }}</label>
      <input class="input" type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password">
    </div>
    <div class="form-row">
      <label for="ResetConfirm">Confirm password</label>
      <input class="input" type="password" id="ResetConfirm" name="customer[password_confirmation]" autocomplete="new-password">
    </div>
    <button class="btn btn--primary btn--full" type="submit">{{ 'customer.reset_password.submit' | t }}</button>
  {%- endform -%}
</div>
{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
