{%- comment -%}
  A row of photographs, each with a short heading and a line of copy under it —
  for a sequence (picked, dried, graded, packed) or any set of things worth
  showing side by side. The pictures take the arch, as every picture panel on
  the label does; the copy stays square beneath them.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  case s.ratio
    when 'square'
      assign ratio = '1/1'
    when 'landscape'
      assign ratio = '4/3'
    else
      assign ratio = '4/5'
  endcase
  assign cols = s.columns | plus: 0
  assign vw = 100 | divided_by: cols
  assign sizes = '(max-width:560px) 100vw, (max-width:900px) 50vw, ' | append: vw | append: 'vw'
-%}
<div class="wrap section-pad">
  {%- if s.label != blank -%}
    <div class="speclabel">
      <span class="speclabel__no">{{ s.number }}</span>
      <span class="speclabel__name">{{ s.label }}</span>
      <span class="speclabel__rule"></span>
      <span class="speclabel__meta">{{ s.meta }}</span>
    </div>
  {%- endif -%}
  {%- if s.heading != blank or s.text != blank -%}
    <div class="photo-intro">
      {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="rte">{{ s.text }}</div>{%- endif -%}
    </div>
  {%- endif -%}
  <div class="photo-cols" style="--photo-cols:{{ cols }};--photo-ratio:{{ ratio }};">
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <article class="photo-col" {{ block.shopify_attributes }}>
        <div class="photo-col__art">
          {%- if b.image -%}
            {%- assign alt_text = b.image_alt | default: b.image.alt | default: b.title | escape -%}
            {%- capture pos -%}object-position:{{ b.image.presentation.focal_point }}{%- endcapture -%}
            {{ b.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360,540,720,960,1200', sizes: sizes, alt: alt_text, style: pos }}
          {%- else -%}
            <span class="photo__empty">
              {% render 'botanical', variant: 'field' %}
              {%- if request.design_mode -%}<span class="photo__hint">Add a photograph</span>{%- endif -%}
            </span>
          {%- endif -%}
        </div>
        <div class="photo-col__body">
          {%- if s.numbered -%}<span class="photo-col__n">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>{%- endif -%}
          {%- if b.title != blank -%}<h3 class="photo-col__title">{{ b.title }}</h3>{%- endif -%}
          {%- if b.text != blank -%}<div class="rte photo-col__text">{{ b.text }}</div>{%- endif -%}
          {%- if b.link_label != blank -%}
            <a class="linkish photo-col__link" href="{{ b.link | default: routes.all_products_collection_url }}">{{ b.link_label }}</a>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Photo columns",
  "settings": [
    { "type": "text", "id": "number", "label": "Section mark", "default": "§ —" },
    { "type": "text", "id": "label", "label": "Label", "default": "From the hills to the tin", "info": "Leave empty to drop the section header." },
    { "type": "text", "id": "meta", "label": "Right-hand note", "default": "four steps" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "columns", "label": "Columns per row",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4",
      "info": "Tablets show two, phones one."
    },
    {
      "type": "select", "id": "ratio", "label": "Frame shape",
      "options": [
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ],
      "default": "portrait",
      "info": "Photographs are cropped to fill the frame. Set a focal point on the image to choose what stays in view."
    },
    { "type": "checkbox", "id": "numbered", "label": "Number the columns", "default": true, "info": "01, 02, 03… above each heading. Turn off when the columns are not a sequence." }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Image description", "info": "For screen readers. Defaults to the heading." },
        { "type": "text", "id": "title", "label": "Heading", "default": "Picked green" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>By hand, several passes to a plant, because the pods on one stem do not ripen together.</p>" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Photo columns",
      "blocks": [
        { "type": "column", "settings": { "title": "Picked green", "text": "<p>By hand, several passes to a plant, because the pods on one stem do not ripen together.</p>" } },
        { "type": "column", "settings": { "title": "Dried slow", "text": "<p>Cured until the pod is dry enough to keep, while it still holds its green and the oil inside.</p>" } },
        { "type": "column", "settings": { "title": "Graded by sieve", "text": "<p>Sorted by the mesh a pod will pass through: 6 mm, 7 mm and 8 mm+.</p>" } },
        { "type": "column", "settings": { "title": "Packed whole", "text": "<p>Sealed light-proof, with the harvest and packing dates printed on the tin.</p>" } }
      ]
    }
  ]
}
{% endschema %}
