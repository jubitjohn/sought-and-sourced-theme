<div class="wrap">
  <div class="dispatch">
    <div>
      <h2 style="margin-bottom:12px">{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
    </div>
    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="field">
        <input type="email" name="contact[email]" required placeholder="{{ 'general.newsletter.email' | t }}" aria-label="{{ 'general.newsletter.email' | t }}">
        <button type="submit">{{ 'general.newsletter.submit' | t }}</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="workings" style="margin-top:8px">{{ 'general.newsletter.success' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>
{% schema %}
{
  "name": "Dispatch signup",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Dispatch" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A note when a new lot is cured and tinned — a few times a year, not a few times a week. Harvest reports, what we passed on, and why.</p>" }
  ],
  "presets": [{ "name": "Dispatch signup" }]
}
{% endschema %}
