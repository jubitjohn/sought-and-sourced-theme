<div class="wrap wrap--narrow" style="padding-bottom:60px">
  <div class="article-head"><h1>{{ 'customer.addresses.title' | t }}</h1></div>
  {%- paginate customer.addresses by 10 -%}
    {%- for address in customer.addresses -%}
      <div style="border-bottom:1px solid var(--rule);padding:18px 0">
        <div class="body-text" style="font-size:.92rem">{{ address | format_address }}</div>
        {%- form 'customer_address', address -%}
          <input type="hidden" name="_method" value="delete">
          <button class="linkish" type="submit">{{ 'customer.addresses.delete' | t }}</button>
        {%- endform -%}
      </div>
    {%- endfor -%}
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}

  <h2 style="margin:30px 0 18px">{{ 'customer.addresses.add' | t }}</h2>
  {%- form 'customer_address', customer.new_address -%}
    <div class="form-row"><label for="AddrFirst">First name</label><input class="input" type="text" id="AddrFirst" name="address[first_name]"></div>
    <div class="form-row"><label for="AddrLast">Last name</label><input class="input" type="text" id="AddrLast" name="address[last_name]"></div>
    <div class="form-row"><label for="Addr1">Address</label><input class="input" type="text" id="Addr1" name="address[address1]"></div>
    <div class="form-row"><label for="AddrCity">City</label><input class="input" type="text" id="AddrCity" name="address[city]"></div>
    <div class="form-row"><label for="AddrZip">Postcode</label><input class="input" type="text" id="AddrZip" name="address[zip]"></div>
    <div class="form-row"><label for="AddrCountry">Country</label><input class="input" type="text" id="AddrCountry" name="address[country]"></div>
    <button class="btn btn--primary" type="submit">{{ 'customer.addresses.add' | t }}</button>
  {%- endform -%}
</div>
{% schema %}
{ "name": "Addresses", "settings": [] }
{% endschema %}
