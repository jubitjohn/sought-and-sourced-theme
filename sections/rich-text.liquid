<div class="wrap wrap--narrow section-pad" style="padding-top:44px">
  {%- if section.settings.heading != blank -%}<h2 style="margin-bottom:18px">{{ section.settings.heading }}</h2>{%- endif -%}
  <div class="rte">{{ section.settings.text }}</div>
</div>
{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share what you look for, what you reject, and why.</p>" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
