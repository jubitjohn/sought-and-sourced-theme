{%- assign cart_name = settings.cart_name | default: 'Cart' -%}
{%- if settings.show_mm_rule -%}
  <div class="mm-rule" aria-hidden="true">
    <div class="mm-rule__ticks"></div>
    <div class="mm-rule__label">millimetres</div>
  </div>
{%- endif -%}
<style>
  {%- comment -%} Sticky on the section wrapper itself, so it holds across the whole page. {%- endcomment -%}
  #shopify-section-{{ section.id }}{position:sticky;top:0;z-index:40;}

  /* Remove the green background behind the logo / name */
  #shopify-section-{{ section.id }} .cartouche{
    background:none !important;
    box-shadow:none !important;
    border:0 !important;
    outline:0 !important;
    color:#1f3b2d !important;
  }
  #shopify-section-{{ section.id }} .cartouche::before,
  #shopify-section-{{ section.id }} .cartouche::after{ display:none !important; }
</style>
<div class="site-header">
<div class="wrap">
  <header class="masthead">
    <a class="brandmark" href="{{ routes.root_url }}">
      <span class="cartouche">
        {%- if section.settings.logo -%}
          {%- assign alt_text = shop.name | escape -%}
          {{ section.settings.logo | image_url: width: 320 | image_tag: alt: alt_text }}
        {%- else -%}
          {% render 'wordmark', sprig: section.settings.show_sprig %}
        {%- endif -%}
      </span>
      {%- if section.settings.tagline != blank -%}
        <span class="brandmark__tag">{{ section.settings.tagline }}</span>
      {%- endif -%}
    </a>

    <nav id="SiteNav" aria-label="Primary">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
    </nav>

    <div class="masthead__actions">
      <button class="cart-link nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="SiteNav">
        {% render 'icon', icon: 'menu' %}
      </button>
      <a class="cart-link" href="{{ routes.search_url }}" aria-label="{{ 'general.search.title' | t }}">
        {% render 'icon', icon: 'search' %}
      </a>
      <a class="cart-link" href="{{ routes.cart_url }}" data-cart-open>
        {{ cart_name }} (<span data-cart-count>{{ cart.item_count }}</span>)
      </a>
    </div>
  </header>
</div>
</div>
{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Shown in the header with no background. Leave empty to set the shop name instead." },
    { "type": "text", "id": "tagline", "label": "Under the name", "default": "Pure · Authentic · Responsible", "info": "The three words printed under the name. Leave empty to drop the line." },
    { "type": "checkbox", "id": "show_sprig", "label": "Show the leaf mark above the name", "default": true },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" }
  ]
}
{% endschema %}
