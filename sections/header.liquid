
{%- assign cart_name = settings.cart_name | default: 'Cart' -%}

{%- if settings.show_mm_rule -%}
  <div class="mm-rule" aria-hidden="true">
    <div class="mm-rule__ticks"></div>
    <div class="mm-rule__label">millimetres</div>
  </div>
{%- endif -%}

<style>
  /* Sticky header */
  #shopify-section-{{ section.id }} {
    position: sticky;
    top: 0;
    z-index: 40;
  }

  /* Reduce header vertical padding */
  #shopify-section-{{ section.id }} .masthead {
    padding-top: 6px;
    padding-bottom: 6px;
  }

  /* Keep logo dimensions natural */
  #shopify-section-{{ section.id }} .brandmark img {
    width: auto;
    height: auto;
    max-width: 320px;
    display: block;
  }

  /* Keep tagline neatly positioned */
  #shopify-section-{{ section.id }} .brandmark__tag {
    display: block;
  }
</style>

<div class="site-header">
  <div class="wrap">
    <header class="masthead">

      <!-- Logo without green cartouche -->
      <a class="brandmark" href="{{ routes.root_url }}">

        {%- if section.settings.logo -%}
          {%- assign alt_text = shop.name | escape -%}
          {{ section.settings.logo | image_url: width: 320 | image_tag: alt: alt_text }}
        {%- else -%}
          {% render 'wordmark', sprig: section.settings.show_sprig %}
        {%- endif -%}

        {%- if section.settings.tagline != blank -%}
          <span class="brandmark__tag">
            {{ section.settings.tagline }}
          </span>
        {%- endif -%}

      </a>

      <!-- Navigation -->
      <nav id="SiteNav" aria-label="Primary">
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}"
            {% if link.current %}aria-current="page"{% endif %}>
            {{ link.title }}
          </a>
        {%- endfor -%}
      </nav>

      <!-- Header actions -->
      <div class="masthead__actions">

        <button
          class="cart-link nav-toggle"
          type="button"
          data-nav-toggle
          aria-expanded="false"
          aria-controls="SiteNav">
          {% render 'icon', icon: 'menu' %}
        </button>

        <a
          class="cart-link"
          href="{{ routes.search_url }}"
          aria-label="{{ 'general.search.title' | t }}">
          {% render 'icon', icon: 'search' %}
        </a>

        <a class="cart-link" href="{{ routes.cart_url }}" data-cart-open>
          {{ cart_name }} (<span data-cart-count>{{ cart.item_count }}</span>)
        </a>

      </div>

    </header>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Upload your store logo. It will appear without a background container."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Under the name",
      "default": "Pure · Authentic · Responsible",
      "info": "Leave empty to hide the tagline."
    },
    {
      "type": "checkbox",
      "id": "show_sprig",
      "label": "Show the leaf mark above the name",
      "default": true
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
