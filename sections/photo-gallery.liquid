{%- comment -%}
  Photographs of the farm and the pods, set as a contact sheet: each one in a
  brass-ruled frame with a tracked-caps caption under it, the way a specimen is
  labelled. 'Lead with the first photograph' runs it at double size.

  A frame with no photograph yet keeps its place with the botanical line work,
  so the section can be laid out before the pictures exist.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  case s.ratio
    when 'square'
      assign ratio = '1/1'
    when 'portrait'
      assign ratio = '4/5'
    else
      assign ratio = '4/3'
  endcase
  assign cols = s.columns | plus: 0
  assign vw = 100 | divided_by: cols
  comment
    Two columns leave the lead photograph nothing to sit beside, so it only
    leads at three or four.
  endcomment
  assign feature = false
  if s.feature_first and cols > 2
    assign feature = true
  endif
-%}
<div class="wrap section-pad">
  {%- if s.label != blank -%}
    <div class="speclabel">
      <span class="speclabel__no">{{ s.number }}</span>
      <span class="speclabel__name">{{ s.label }}</span>
      <span class="speclabel__rule"></span>
      <span class="speclabel__meta">{{ s.meta }}</span>
    </div>
  {%- endif -%}
  {%- if s.heading != blank or s.text != blank -%}
    <div class="photo-intro">
      {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="rte">{{ s.text }}</div>{%- endif -%}
    </div>
  {%- endif -%}
  <div class="photo-grid{% if feature %} photo-grid--feature{% endif %}" style="--photo-cols:{{ cols }};--photo-ratio:{{ ratio }};">
    {%- for block in section.blocks -%}
      {%- liquid
        assign b = block.settings
        assign lead = false
        if feature and forloop.first
          assign lead = true
        endif
        if lead
          assign w = vw | times: 2
          assign sizes = '(max-width:760px) 100vw, ' | append: w | append: 'vw'
        else
          assign sizes = '(max-width:760px) 50vw, ' | append: vw | append: 'vw'
        endif
      -%}
      <figure class="photo" {{ block.shopify_attributes }}>
        {%- if b.link != blank -%}<a class="photo__art" href="{{ b.link }}">{%- else -%}<div class="photo__art">{%- endif -%}
          {%- if b.image -%}
            {%- assign alt_text = b.image_alt | default: b.image.alt | default: b.caption | escape -%}
            {%- capture pos -%}object-position:{{ b.image.presentation.focal_point }}{%- endcapture -%}
            {{ b.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '360,540,720,1000,1400,1600', sizes: sizes, alt: alt_text, style: pos }}
          {%- else -%}
            <span class="photo__empty">
              {% render 'botanical', variant: 'field' %}
              {%- if request.design_mode -%}<span class="photo__hint">Add a photograph</span>{%- endif -%}
            </span>
          {%- endif -%}
        {%- if b.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
        {%- if b.caption != blank -%}<figcaption class="photo__cap">{{ b.caption }}</figcaption>{%- endif -%}
      </figure>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Photo gallery",
  "settings": [
    { "type": "text", "id": "number", "label": "Section mark", "default": "§ —" },
    { "type": "text", "id": "label", "label": "Label", "default": "From the farm", "info": "Leave empty to drop the section header." },
    { "type": "text", "id": "meta", "label": "Right-hand note", "default": "photographs" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "columns", "label": "Photographs per row",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3",
      "info": "Phones always show two."
    },
    {
      "type": "select", "id": "ratio", "label": "Frame shape",
      "options": [
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait (4:5)" }
      ],
      "default": "landscape",
      "info": "Photographs are cropped to fill the frame. Set a focal point on the image to choose what stays in view."
    },
    { "type": "checkbox", "id": "feature_first", "label": "Lead with the first photograph", "default": true, "info": "Runs it at double size. Needs 3 or 4 per row; with 3 per row, 6 photographs fill the grid evenly." }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photograph",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Image description", "info": "For screen readers. Defaults to the caption." },
        { "type": "text", "id": "caption", "label": "Caption", "default": "The Cardamom Hills" },
        { "type": "url", "id": "link", "label": "Link", "info": "Optional. Makes the photograph clickable." }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Photo gallery",
      "blocks": [
        { "type": "photo", "settings": { "caption": "The Cardamom Hills" } },
        { "type": "photo", "settings": { "caption": "Under the shade canopy" } },
        { "type": "photo", "settings": { "caption": "Picking" } },
        { "type": "photo", "settings": { "caption": "Drying" } },
        { "type": "photo", "settings": { "caption": "Sorting" } },
        { "type": "photo", "settings": { "caption": "The pods" } }
      ]
    }
  ]
}
{% endschema %}
