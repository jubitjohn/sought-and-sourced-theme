<div class="wrap wrap--narrow" style="padding-bottom:60px">
  <div class="article-head"><h1>{{ page.title }}</h1></div>
  <div class="article-body rte">{{ page.content }}</div>
  {%- form 'contact' -%}
    {%- if form.posted_successfully? -%}
      <p class="workings">Thank you — we'll reply.</p>
    {%- endif -%}
    {%- if form.errors -%}
      <div class="form-error">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div class="form-row">
      <label for="ContactName">Name</label>
      <input class="input" type="text" id="ContactName" name="contact[name]" required>
    </div>
    <div class="form-row">
      <label for="ContactEmail">Email</label>
      <input class="input" type="email" id="ContactEmail" name="contact[email]" required>
    </div>
    <div class="form-row">
      <label for="ContactBody">Message</label>
      <textarea class="input" id="ContactBody" name="contact[body]" rows="6" required></textarea>
    </div>
    <button class="btn btn--primary" type="submit">Send</button>
  {%- endform -%}
</div>
{% schema %}
{ "name": "Contact", "settings": [] }
{% endschema %}
