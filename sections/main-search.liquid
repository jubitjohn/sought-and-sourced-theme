<div class="wrap">
  <div class="collection-head">
    <div>
      <h1>{{ 'general.search.title' | t }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" style="margin-top:18px">
        <div class="field">
          <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.title' | t }}">
          <button type="submit">{{ 'general.search.submit' | t }}</button>
        </div>
      </form>
    </div>
  </div>
  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      {%- if search.results_count > 0 -%}
        <p class="eyebrow" style="margin-bottom:18px">{{ 'general.search.results_for' | t: terms: search.terms }}</p>
        <div class="cards">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item, pod_mm: 7 %}
            {%- else -%}
              <article class="card"><div class="card__body">
                <h3 class="card__name"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                <p class="card__note">{{ item.content | strip_html | truncate: 120 }}</p>
              </div></article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="empty-state">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  {%- endif -%}
</div>
{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
