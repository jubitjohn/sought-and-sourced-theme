<div class="wrap wrap--narrow">
  <div class="empty-state">
    <h1>{{ section.settings.heading }}</h1>
    <div class="rte" style="margin:0 auto 26px">{{ section.settings.text }}</div>
    <a class="btn btn--ghost" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
  </div>
</div>
{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Nothing catalogued here." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>The page you asked for isn't in the record. The shop is through here.</p>" }
  ]
}
{% endschema %}
