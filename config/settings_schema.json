      { "type": "paragraph", "content": "Instrument Serif for display, Instrument Sans for text, IBM Plex Mono for every measurement, grade, date and price. Loaded from Google Fonts in layout/theme.liquid." },
      { "type": "range", "id": "type_base_size", "label": "Base text size", "min": 14, "max": 20, "step": 1, "unit": "px", "default": 16 },
      { "type": "range", "id": "type_display_scale", "label": "Display scale", "min": 80, "max": 130, "step": 5, "unit": "%", "default": 100 }
    ]
  },
  {
    "name": "Layout",
    "settings": [
