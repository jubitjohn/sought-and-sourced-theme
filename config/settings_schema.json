[
  {
    "name": "theme_info",
    "theme_name": "Sought & Sourced",
    "theme_version": "1.0.0",
    "theme_author": "Sought & Sourced",
    "theme_documentation_url": "https://shopify.dev/themes",
    "theme_support_url": "https://shopify.dev/themes"
  },
  {
    "name": "Colours",
    "settings": [
      { "type": "paragraph", "content": "Taken off the printed label: ivory stock, bottle green for every reversed band and action, and brass for every rule. Brass has two values because brass on ivory and brass on green are not the same colour — keep both." },
      { "type": "color", "id": "color_ground", "label": "Page ground (label stock)", "default": "#F1EBD9" },
      { "type": "color", "id": "color_sheet", "label": "Sheet / card", "default": "#F8F4E7" },
      { "type": "color", "id": "color_sheet_2", "label": "Sheet, recessed", "default": "#F0EAD8" },
      { "type": "color", "id": "color_ink", "label": "Ink", "default": "#123527" },
      { "type": "color", "id": "color_ink_2", "label": "Ink, secondary", "default": "#4A6154" },
      { "type": "color", "id": "color_ink_3", "label": "Ink, faint", "default": "#586A5F" },
      { "type": "color", "id": "color_rule", "label": "Rules and borders", "default": "#C8B47A" },
      { "type": "color", "id": "color_rule_soft", "label": "Rules, soft", "default": "#DFD3AE" },
      { "type": "color", "id": "color_pod", "label": "Bottle green (actions, reversed bands)", "default": "#0B4531" },
      { "type": "color", "id": "color_deep", "label": "Bottle green, deep (header and footer ground)", "default": "#07301F" },
      { "type": "color", "id": "color_gold", "label": "Brass — rules and ornament", "default": "#B8912F", "info": "Ornament only. It is too light to read as body text on ivory." },
      { "type": "color", "id": "color_gold_lit", "label": "Brass on green — type and rules over a dark band", "default": "#E0C67E" },
      { "type": "color", "id": "color_stamp", "label": "Brass ink — small type on ivory", "default": "#7A5E14", "info": "Darkened brass, used where the ornament gold would fail contrast: grades, section marks, the days-on-shelf figure." },
      { "type": "color", "id": "color_botanical", "label": "Botanical watermark", "default": "#DED2B2" },
      { "type": "color", "id": "color_alert", "label": "Alert — form errors only", "default": "#8C3A24", "info": "The label prints no red, so nothing decorative uses this. It exists so a failed form still reads as a failure rather than as more brass." },
      { "type": "color", "id": "color_grid", "label": "Graph paper rule", "default": "#DFD5B8" },
      { "type": "color", "id": "color_pod_fill", "label": "Pod illustration fill", "default": "#BFD0A8" },
      { "type": "color", "id": "color_pod_line", "label": "Pod illustration line", "default": "#5C7A4A" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      { "type": "paragraph", "content": "Playfair Display for display — the label's high-contrast serif, set in caps with wide tracking for the wordmark and large for the product name. Instrument Sans for text and the small letterspaced caps. IBM Plex Mono for every measurement, grade, date and price. Loaded from Google Fonts in layout/theme.liquid." },
      { "type": "range", "id": "type_base_size", "label": "Base text size", "min": 14, "max": 20, "step": 1, "unit": "px", "default": 16 },
      { "type": "range", "id": "type_display_scale", "label": "Display scale", "min": 80, "max": 130, "step": 5, "unit": "%", "default": 100 }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      { "type": "range", "id": "layout_width", "label": "Content width", "min": 960, "max": 1400, "step": 20, "unit": "px", "default": 1120 },
      { "type": "checkbox", "id": "show_mm_rule", "label": "Show the millimetre rule down the page edge", "default": true }
    ]
  },
  {
    "name": "Product",
    "settings": [
      { "type": "header", "content": "Price per dish" },
      { "type": "paragraph", "content": "Computed from each variant's shipping weight, so no metafield is needed. Set the grams a single dish uses — the default assumes 4 pods at roughly 0.15 g each." },
      { "type": "checkbox", "id": "show_per_dish", "label": "Show price per dish", "default": true },
      { "type": "text", "id": "grams_per_dish", "label": "Grams per dish", "default": "0.6" },
      { "type": "text", "id": "per_dish_label", "label": "Label", "default": "per dish" },
      { "type": "checkbox", "id": "show_workings", "label": "Show the arithmetic underneath", "default": true },
      { "type": "header", "content": "Freshness stamp" },
      { "type": "paragraph", "content": "Reads the product metafields custom.harvest_month (single line text) and custom.packed_on (date). Any row with no value hides itself — the stamp never shows an empty or future date." },
      { "type": "checkbox", "id": "show_freshness", "label": "Show the freshness stamp", "default": true }
    ]
  },
  {
    "name": "Consignment",
    "settings": [
      { "type": "text", "id": "cart_name", "label": "What the cart is called", "default": "Consignment", "info": "Used in the header, the drawer and the buttons." },
      { "type": "select", "id": "cart_type", "label": "Cart behaviour", "options": [ { "value": "drawer", "label": "Slide-out drawer" }, { "value": "page", "label": "Go to the cart page" } ], "default": "drawer" }
    ]
  },
  {
    "name": "Social",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_whatsapp", "label": "WhatsApp URL" },
      { "type": "text", "id": "social_email", "label": "Contact email" },
      { "type": "image_picker", "id": "share_image", "label": "Default sharing image" },
      { "type": "image_picker", "id": "favicon", "label": "Favicon" }
    ]
  }
]
