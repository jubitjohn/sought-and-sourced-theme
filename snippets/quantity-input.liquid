<div class="qty">
  <button type="button" name="minus" aria-label="{{ 'products.product.quantity' | t }} −">&minus;</button>
  <input type="number" name="quantity" value="1" min="1" step="1" aria-label="{{ 'products.product.quantity' | t }}">
  <button type="button" name="plus" aria-label="{{ 'products.product.quantity' | t }} +">+</button>
</div>
